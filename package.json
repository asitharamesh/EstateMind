{
  "name": "estatemind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:api": "test -x ./.venv/bin/python && ./.venv/bin/python -m uvicorn backend.app:app --reload --reload-dir backend --port 8000 || python3 -m uvicorn backend.app:app --reload --reload-dir backend --port 8000",
    "dev:full": "concurrently -n web,api -c blue,green \"npm:dev\" \"npm:dev:api\"",
    "train:model": "test -x ./.venv/bin/python && ./.venv/bin/python -m backend.scripts.train_model || python3 -m backend.scripts.train_model",
    "benchmark:model": "test -x ./.venv/bin/python && ./.venv/bin/python -m backend.scripts.benchmark_model || python3 -m backend.scripts.benchmark_model",
    "test:api": "test -x ./.venv/bin/python && ./.venv/bin/python -m pytest || python3 -m pytest",
    "build": "npm run build --workspace frontend",
    "build:dev": "npm run build:dev --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "preview": "npm run preview --workspace frontend",
    "test": "npm run test --workspace frontend",
    "test:watch": "npm run test:watch --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
