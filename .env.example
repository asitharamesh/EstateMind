# Leave VITE_API_BASE_URL unset for local dev: the frontend then calls
# relative /api/* paths, which Vite's dev server proxies to the FastAPI
# backend (see vite.config.ts) - no CORS setup needed. Only set this to
# point the built frontend at a specific host, e.g. a deployed API:
# VITE_API_BASE_URL=https://api.example.com

# Only needed if the backend runs on a non-default host/port; changes what
# Vite's dev proxy forwards /api/* to (defaults to http://127.0.0.1:8000).
# API_PROXY_TARGET=http://127.0.0.1:8000

# Optional overrides for backend/scripts/train_model.py and backend/app.py.
# Real King County, WA home-sale data (~21.6k transactions) - the model's
# actual training source, not a synthetic formula. Relative paths below are
# resolved against backend/ (not the current working directory).
# DATASET_URL=https://raw.githubusercontent.com/karan-shah/usa-housing-dataset/master/kc_house_data.csv
# DATASET_PATH=assets/kc_house_data.csv

# Zillow Research public ZHVI-by-metro CSV, used to derive a real, cited
# cross-metro price adjustment (see build_metro_price_index in train_model.py).
# METRO_INDEX_URL=https://files.zillowstatic.com/research/public_csvs/zhvi/Metro_zhvi_uc_sfrcondo_tier_0.33_0.67_sm_sa_month.csv

# OUTPUT_DIR=assets
# MODEL_FILE=random_forest_model.pkl
# METRICS_FILE=model_metrics.json
# FEATURES_FILE=feature_columns.json

# Where the generated frontend-served JSON snapshots (model-metrics.json and
# friends) are written. Relative paths are resolved against the repo root.
# PUBLIC_DIR=frontend/public

# CORS_ORIGINS=*
